#!/bin/sh
# Wrapper: run the local (dev) version of llme, not the one installed in PATH.
# Resolution: project venv -> uv -> pip3
# Note: once the venv installed, uv and pip3 paths are shortcut
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$root/.venv/bin/llme" ]; then
	exec "$root/.venv/bin/llme" "$@"
elif command -v uv >/dev/null 2>&1; then
	exec uv --project "$root" run llme "$@"
elif command -v pip3 >/dev/null 2>&1; then
	python3 -m venv "$root/.venv" &&
	. "$root/.venv/bin/activate" &&
	pip3 install --upgrade pip &&
	pip3 install -e "$root" &&
	exec "$root/.venv/bin/llme" "$@"
else
	echo "Weird python env. Install uv." >&2
	exit 1
fi
